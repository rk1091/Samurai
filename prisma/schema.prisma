generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trace {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  projectTag    String
  prompt        String
  response      String?
  model         String
  tokensIn      Int?
  tokensOut     Int?
  costUsd       Float?
  latencyMs     Int
  status        String   // success | fail | timeout
  errorMessage  String?

  parentTraceId String?
  parent        Trace?   @relation("TraceChain", fields: [parentTraceId], references: [id])
  children      Trace[]  @relation("TraceChain")

  @@index([projectTag])
  @@index([status])
  @@index([model])
}
